# 로컬(wrangler pages dev)에서는 이 파일을 .dev.vars 로 복사해 값을 채운다.
# 배포(Cloudflare Pages)에서는 Settings > Variables and Secrets 에 같은 이름으로 입력한다.
# 실제 키는 절대 커밋하지 말 것 (.gitignore 가 .env, .dev.vars 를 막고 있다).

# 서울 열린데이터광장 인증키 (실시간 지하철 도착정보)
SEOUL_API_KEY=

# 공공데이터포털 서비스키 — 반드시 "일반 인증키(Decoding)" 값. (Encoding 키를 넣어도 % 가 있으면 자동 디코딩한다)
# 국토교통부 TAGO 버스도착정보 / 버스정류소정보 활용신청 후 발급.
DATA_GO_KR_KEY=

# 1 로 두면 키가 있어도 모의 데이터 모드. (두 키가 모두 비어 있으면 자동으로 모의 모드)
MOCK=
